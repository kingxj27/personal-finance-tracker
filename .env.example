# Backend environment variables
# Copy this to .env and fill in your values

# JWT secret — change to a long random string in production
JWT_SECRET=your-super-secret-jwt-key-change-me

# Anthropic API key — get yours at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Server port (optional, defaults to 4000)
PORT=4000

# Database URL — SQLite for local dev, PostgreSQL for production
# Local (SQLite — no config needed, uses dev.db)
# DATABASE_URL="file:./dev.db"

# Production (PostgreSQL on Railway/Render)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
